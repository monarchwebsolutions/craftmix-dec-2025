{% liquid 
  if settings.lang_direction contains request.locale.iso_code
    assign is_rtl = true
    assign class_image_ratio = "w-8 h-8 ml-4"
  else
    assign is_rtl = false
    assign class_image_ratio = "w-8 h-8 mr-4"
  endif
  if section.settings.enable_highlight
    assign menus = section.settings.menus | newline_to_br | strip_newlines | split: '<br />'
  endif
%}
{%- style -%}
  {% if section.settings.enable_highlight %}
    .svg-highlight-{{ section.id }} {
    {% if section.settings.highlight_color_light != blank and section.settings.highlight_color_light.alpha != 0.0 %}
      --color-highlight: {{ section.settings.highlight_color_light }};
    {% endif %}
    }
    .dark .svg-highlight-{{ section.id }} {
      {% if section.settings.highlight_color_dark != blank and section.settings.highlight_color_dark.alpha != 0.0 %}
        --color-highlight: {{ section.settings.highlight_color_dark }};
      {% else %}
        --color-highlight: {{ settings.colors_dark_heading_highlight }};
      {% endif %}
    }
  {% endif %}
{%- endstyle -%}

<nav {% if section.settings.select_motion == 'click' %}x-on:click.away="$store.xHeaderMenu.hideMenu($el)"{% endif %} class="[grid-area:navigation] w-full pb-header{% if logo_above %} lg:[grid-area:navigation] mt-4{% else %}{% unless logo_center %} lg:[grid-area:auto]{% endunless %}{% endif %} order-3 hidden header__inline-menu lg:flex items-center{% if section.settings.logo_position == 'left-center' or section.settings.logo_position == "above-center" %} justify-center{% endif %}{% if section.settings.logo_position == 'left-right' %} justify-end pr-5{% endif %}">

  {% unless request.path == '/pages/2025-landing-page' %}

  <ul class="list-menu inline-flex flex-wrap items-center{% if section.settings.logo_position == 'left-right' %} justify-end{% endif %}{% if section.settings.logo_position == 'left-center' or section.settings.logo_position == "above-center" %} justify-center{% endif %}">

    <!-- SHOP TRIGGER -->
    <li class="relative">
      <a
        id="header-shop-button"
        href="#"
        aria-controls="header-mega-menu"
        aria-expanded="false"
        class="cursor-pointer p-break-words flex items-center justify-center pt-1 pb-1 relative"
        x-init="$store.xHeaderMenu.isTouch &amp;&amp; $store.xHeaderMenu.touchItem($el)"
      >
        <span>Shop</span>
        <span class="w-5 pl-2">
          <svg class="shop-chevron" width="100%" height="100%" viewBox="0 0 9 7" fill="none" xmlns="http://www.w3.org/2000/svg" style="fill: none;" alt="Chevron">
            <path d="M0.75 1.625L4.5 5.375L8.25 1.625" stroke="currentcolor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
      </a>
    </li>

    <!-- MEGA MENU (MUST BE INSIDE AN LI FOR VALID UL STRUCTURE) -->
    <li class="relative">
      <div
        id="header-mega-menu"
        class="mega-menu-container"
        hidden
        aria-hidden="true"
      >
        <div class="mega-menu-inner-wrapper">
          <div class="left-column">

            <a href="/pages/party-pack">
              <div class="party-pack-selector-container">
                <div class="party-pack-selector">
                  <div class="party-pack-selector-image-container">
                    <img src="https://cdn.shopify.com/s/files/1/2340/1623/files/1-_61_2_-min.png?v=1752992776" alt="Colorful assortment of Craftmix cocktails in various glasses garnished with fruit and mint on a light blue background.">
                  </div>
                  <div class="party-pack-selector-details-container">
                    <h2>Special Offer</h2>
                    <div class="party-pack-selector-price">
                      <img class="special-offer-price-tag" height=40 width=112 src="https://cdn.shopify.com/s/files/1/2340/1623/files/Screenshot_2025-08-26_at_3.11.53_PM-removebg-preview.png?v=1756235570" alt="Orange price tag reading '$45.59'">
                    </div>
                    <div class="party-pack-selector-original-price">
                      $75.99
                    </div>
                    <div class="party-pack-selector-title">
                      60 drinks / 10 flavors
                    </div>
                  </div>
                </div>
              </div>
            </a>

            <div class="mega-menu-cta-container">
              <a class="primary-cta mega-menu-shop-all-cta" href="/collections/flavors-2024">Shop All Flavors</a>
            </div>

            <div class="mega-menu-cta-container">
              <a class="primary-cta mega-menu-subscribe-cta" href="/pages/subscriptions">Subscribe Today - Learn more</a>
            </div>
          </div>

          <div class="middle-column">
            {% assign bestsellers = collections['megamenu-bestsellers'].products %}
            {% assign bestseller_1 = bestsellers[0] %}
            {% assign bestseller_2 = bestsellers[1] %}

            <!-- Bestseller 1 -->
            {% if bestseller_1 and bestseller_1.featured_image %}
              <a class="mega-menu-bestseller" id="shop-all-bestseller-1" style="background-color: {{ bestseller_1.metafields.custom.color_2 }}" href="{{ bestseller_1.url }}">
                <div class="bestseller-img-container">
                  <img class="bestseller-img lazy-img" height="100" width="100" data-src="{{ bestseller_1.images.last | image_url: width: 200 }}" alt="{{ bestseller_1.title }}">
                </div>
                <div class="bestseller-text">
                  <div class="header-bestseller-badge">Bestseller</div>
                  <h2>{{ bestseller_1.title }}</h2>
                  <p class="bestseller-benefits">Get 25% OFF For a Limited Time</p>
                </div>
              </a>
            {% else %}
              <p>Bestseller 1 not available.</p>
            {% endif %}

            <!-- Bestseller 2 -->
            {% if bestseller_2 and bestseller_2.featured_image %}
              <a class="mega-menu-bestseller" id="shop-all-bestseller-2" style="background-color: {{ bestseller_2.metafields.custom.color_2 }}" href="{{ bestseller_2.url }}">
                <div class="bestseller-img-container">
                  <img class="bestseller-img lazy-img" height="100px" width="100px" data-src="{{ bestseller_2.images.last | image_url: width: 200 }}" alt="{{ bestseller_2.title }}">
                </div>
                <div class="bestseller-text">
                  <div class="header-bestseller-badge">Bestseller</div>
                  <h2>{{ bestseller_2.title }}</h2>
                  <p class="bestseller-benefits">Get 25% OFF For a Limited Time</p>
                </div>
              </a>
            {% else %}
              <p>Bestseller 2 not available.</p>
            {% endif %}
          </div>

          <div class="right-column">
            <div class="mega-menu-grid-container">
              {% for product in collections['mega-menu-2025'].products %}
                {% unless product.tags contains "price_test" %}
                  <a href="{{ product.url }}" class="mega-menu-grid-cell">
                    <img class="lazy-img" height="100px" width="100px" data-src="{{ product.metafields.custom.product_icon | img_url: '100x' }}" alt="{{ product.title }}">
                    <h2>{{ product.title }}</h2>
                  </a>
                  {% if forloop.index == 12 %}
                    {% break %}
                  {% endif %}
                {% endunless %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    </li>

    {%- if section.settings.menu != blank -%}
      {%- for link in section.settings.menu.links -%}
        {%- liquid
          assign is_link = false
          assign is_active = false
          if link.links != blank
            assign is_link = true
            for link_child in link.links
              if link_child.current or link_child.child_active
                assign is_active = true
              endif
            endfor
          endif
        -%}
        <li
          class="tree-menu pr-5{% if logo_center %} mr-7{% else %} pl-5{% endif %}{% if is_link %} relative has-dropdown{% endif %}"
        >
          <div class="relative" x-data='{ active: false }'>
            <a
              href="#"
              class="cursor-pointer tree-menu-item p-break-words{% if is_link %} flex items-center{% else %} inline-block{% endif %}{% if is_active or request.path == link.url %}  link-active{% endif %} justify-center pt-1 pb-1 relative duration-200 transition hover-text-link :link-active{% if request.path == link %} link-active{% endif %}"
              {% if is_link %}x-init="$store.xHeaderMenu.isTouch && $store.xHeaderMenu.touchItem($el)"{% endif %}
              {% if select_motion == "click" and is_link %}
                @click="$store.xHeaderMenu.clickItem($el, $event)"
              {% endif %}
            >
              {% assign title = link.title %}
              {% if section.settings.enable_highlight %}
                {% liquid
                  assign is_highlight = false
                  assign list_menu = menus | join: '||' | prepend: '||' | append: '||' | escape
                  assign menu_item = '||' | append: title | append: '||' | escape
                  if list_menu contains menu_item
                    assign is_highlight = true
                  endif
                %}
                {% if is_highlight %}
                  {% render 'menu-highlight',
                    highlight_type: section.settings.highlight_style,
                    menu_title: title,
                    section_id: section.id,
                    transparent: transparent
                  %}
                {% else %}
                  <span>{{ title | escape }}</span>
                {% endif %}
              {% else %}
                <span>{{ title | escape }}</span>
              {% endif %}
              {%- if is_link -%}
                <span class="w-5{% if is_rtl %} pr-2{% else %} pl-2{% endif %}">{% render 'icon-alls', icon: 'icon-caret' %}</span>
              {%- endif -%}
            </a>
          </div>

          {%- if is_link -%}
            <template x-if="!runDispatch">
              <div
                class="toggle-menu toggle-menu-hidden text-[rgba(var(--colors-text))] absolute z-50 background-header top-full w-48 xl:w-[222px] shadow-md :text-[rgba(var(--colors-text))] duration-300"
                x-init="$store.xHeaderMenu.setPosition($el,1); $store.xHeaderMenu.resizeWindow($el,1)"
              >
                <ul class="tree-menu-nav">
                  {% assign level = 0 %}
                  {%- for link in link.links -%}
                    {%- liquid
                      assign is_link = false
                      if link.links != blank
                        assign is_link = true
                      endif
                      if link.levels > level
                        assign level = link.levels
                      endif
                    -%}
                    <li x-data="{ openSub: false }" class="relative font-normal">
                      <div class="sub-menu flex items-center">
                        <span class="flex-1">
                          <a
                            href="{{ link.url }}"
                            class="relative p-break-words{% if is_link %} flex items-center{% if is_rtl %} pl-5{% else %} pr-5{% endif %}{% else %} inline-block{% endif %} duration-200 transition hover-text-link :effect-inline{% if link.current or link.child_active %} flex border-b effect-inline{% endif %}"
                            {% if select_motion == "click" and is_link %} @click="openSub = true; $store.xHeaderMenu.clickItem($el, $event, true, true)"{% endif %}
                          >
                            <span>{{ link.title | escape }}</span>
                            {%- if is_link -%}
                              <span class="icon z-10 w-5 h-4 p-1 rounded-full block absolute -rotate-90{% if is_rtl %} left-0{% else %} right-0{% endif %}">
                                {% render 'icon-alls', icon: 'icon-caret' %}
                              </span>
                            {%- endif -%}
                            <img width="20px" height="7px" src="{{ 'craftmix-nav-arrow.svg' | asset_url }}" class="navigation-arrow" alt="Navigation Arrow">
                          </a>
                        </span>
                      </div>

                      {%- if is_link -%}
                        <div class="sub-menu-toggle background-header child absolute{% if forloop.first %} -top-5{% else %} -top-2{% endif %} w-full shadow-showdownInset left-full" :class="openSub ? 'opacity-1 max-h-auto' : 'opacity-0 max-h-0 overflow-hidden' ">
                          <ul class="pt-5 pb-5">
                            {%- for childlink in link.links -%}
                              <li class="relative{% if is_rtl %} pr-7 pl-6{% else %} pl-7 pr-6{% endif %}">
                                <div class="flex items-center{% unless forloop.first %} pt-3{% endunless %}">
                                  <span class="flex-1">
                                    <a href="{{ childlink.url }}" class="inline-block p-break-words relative duration-200 hover-text-link transition -subchild:effect-inline{% if childlink.current or childlink.child_active %} border-b effect-inline{% endif %}">
                                      <span>{{ childlink.title | escape }}</span>
                                    </a>
                                  </span>
                                </div>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </div>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>

                {% if level > 0 %}
                  <div class="hidden {{ level }}" x-init="$store.xHeaderMenu.setPosition($el,{{ level | plus: 1 }}); $store.xHeaderMenu.resizeWindow($el,{{ level | plus: 1 }})"></div>
                {% endif %}
              </div>
            </template>
          {%- endif -%}
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>

  {% endunless %}

</nav>

<!-- Existing script: Add arrows to About dropdown on hover -->
<script defer>
  const observer = new MutationObserver(() => {
    const menuItems = document.querySelectorAll('header .sub-menu span.flex-1');
    if (menuItems.length > 0) {
      observer.disconnect();
      menuItems.forEach(item => {
        item.addEventListener('mouseenter', () => {
          const arrow = item.querySelector('.navigation-arrow');
          if (arrow) arrow.style.display = 'inline-block';
        });

        item.addEventListener('mouseleave', () => {
          const arrow = item.querySelector('.navigation-arrow');
          if (arrow) arrow.style.display = 'none';
        });
      });
    }
  });

  observer.observe(document.body, { childList: true, subtree: true });
</script>

<script>
document.addEventListener("DOMContentLoaded", () => {

  /*
    ABOUT dropdown (existing behavior)
    NOTE: This script expects .toggle-menu to exist and toggles the first .tree-menu-item.
  */
  const treeMenuItems = document.querySelectorAll("a.tree-menu-item");

  treeMenuItems.forEach(item => {
    item.addEventListener("click", (event) => {
      event.preventDefault();

      const parentLi = item.closest("li.tree-menu");
      if (!parentLi) return;

      const toggleMenu = parentLi.querySelector(".toggle-menu");
      if (toggleMenu) {
        toggleMenu.classList.toggle("toggle-menu-hidden");

        const relativeDiv = parentLi.querySelector(".relative");
        if (relativeDiv) {
          if (toggleMenu.classList.contains("toggle-menu-hidden")) {
            relativeDiv.style.background = "";
            relativeDiv.style.border = "2px solid transparent";
            relativeDiv.style.borderRadius = "";
          } else {
            relativeDiv.style.background = "var(--craftmix-light-blue)";
            relativeDiv.style.border = "2px solid var(--craftmix-dark-blue)";
            relativeDiv.style.borderRadius = "100px";
          }
        }
      }

      const svg = item.querySelector("svg");
      if (svg) svg.classList.toggle("rotated");
    });
  });

  // Click outside header closes ABOUT dropdown
  document.addEventListener("click", (event) => {
    const headerContainer = document.querySelector("#x-header-container");
    if (headerContainer && headerContainer.contains(event.target)) return;

    const relativeDivs = document.querySelectorAll("li.tree-menu > .relative");
    relativeDivs.forEach(relativeDiv => {
      relativeDiv.style.background = "";
      relativeDiv.style.border = "2px solid transparent";
      relativeDiv.style.borderRadius = "";
    });

    const toggleMenus = document.querySelectorAll("div.toggle-menu");
    toggleMenus.forEach(toggleMenu => {
      if (!toggleMenu.classList.contains("toggle-menu-hidden")) {
        toggleMenu.classList.add("toggle-menu-hidden");
      }
    });

    // rotate svg back (best-effort, matching your prior intent)
    const firstSvg = document.querySelector("a.tree-menu-item svg");
    if (firstSvg && firstSvg.classList.contains("rotated")) {
      firstSvg.classList.remove("rotated");
    }
  });

  /*
    SHOP mega menu: OPEN/CLOSE via hidden + aria + FOCUS TRAP
  */
  const shopButton = document.querySelector('a#header-shop-button');
  const megaMenu = document.querySelector('#header-mega-menu');

  if (shopButton && megaMenu) {
    let lastFocusedEl = null;

    const focusableSelector = [
      'a[href]',
      'button:not([disabled])',
      'input:not([disabled])',
      'select:not([disabled])',
      'textarea:not([disabled])',
      '[tabindex]:not([tabindex="-1"])'
    ].join(',');

    function getFocusable(container) {
      return Array.from(container.querySelectorAll(focusableSelector))
        .filter(el => !el.hasAttribute('disabled'))
        .filter(el => el.offsetParent !== null);
    }

    function isShopOpen() {
      return megaMenu.hidden === false;
    }

    function rotateShopChevron(isOpen) {
      const svgIcon = shopButton.querySelector('svg.shop-chevron');
      if (!svgIcon) return;
      svgIcon.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
    }

    function openShopMenu() {
      if (isShopOpen()) return;

      lastFocusedEl = document.activeElement;

      megaMenu.hidden = false;
      megaMenu.setAttribute('aria-hidden', 'false');
      shopButton.setAttribute('aria-expanded', 'true');
      shopButton.classList.add('dropdown-selected');
      rotateShopChevron(true);

      const focusables = getFocusable(megaMenu);
      if (focusables.length) {
        focusables[0].focus();
      } else {
        megaMenu.setAttribute('tabindex', '-1');
        megaMenu.focus();
      }

      document.addEventListener('keydown', onShopKeydown, true);
      document.addEventListener('click', onShopDocClick, true);
    }

    function closeShopMenu() {
      if (!isShopOpen()) return;

      megaMenu.hidden = true;
      megaMenu.setAttribute('aria-hidden', 'true');
      shopButton.setAttribute('aria-expanded', 'false');
      shopButton.classList.remove('dropdown-selected');
      rotateShopChevron(false);

      document.removeEventListener('keydown', onShopKeydown, true);
      document.removeEventListener('click', onShopDocClick, true);

      if (lastFocusedEl && typeof lastFocusedEl.focus === 'function') {
        lastFocusedEl.focus();
      } else {
        shopButton.focus();
      }
    }

    function onShopKeydown(e) {
      if (!isShopOpen()) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeShopMenu();
        return;
      }

      if (e.key !== 'Tab') return;

      const focusables = getFocusable(megaMenu);
      if (!focusables.length) {
        e.preventDefault();
        return;
      }

      const first = focusables[0];
      const last = focusables[focusables.length - 1];

      if (!megaMenu.contains(document.activeElement)) {
        e.preventDefault();
        first.focus();
        return;
      }

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    function onShopDocClick(e) {
      if (!isShopOpen()) return;
      if (megaMenu.contains(e.target) || shopButton.contains(e.target)) return;
      closeShopMenu();
    }

    shopButton.addEventListener('click', function (event) {
      event.preventDefault();
      isShopOpen() ? closeShopMenu() : openShopMenu();
    });

    /*
      ABOUT vs SHOP coordination (keeps your intent, but uses "hidden" to detect shop state)
    */
    const aboutBtn = document.querySelector('.tree-menu-item'); // your first tree-menu item
    const ABOUT_MENU_SELECTOR = '.toggle-menu';

    function isAboutOpen() {
      const el = document.querySelector(ABOUT_MENU_SELECTOR);
      if (!el) return false;
      return !el.classList.contains('toggle-menu-hidden');
    }

    let isSwitching = false;

    function handleMenuToggle(clickedBtn, otherBtn, otherMenuCheckFn) {
      return function (e) {
        if (isSwitching) return;
        const otherOpen = otherMenuCheckFn();

        if (otherOpen) {
          e.preventDefault();
          e.stopImmediatePropagation();
          isSwitching = true;

          otherBtn.click();

          setTimeout(() => {
            const synthetic = new MouseEvent('click', { bubbles: true, cancelable: true });
            clickedBtn.dispatchEvent(synthetic);
            isSwitching = false;
          }, 200);
        }
      };
    }

    if (aboutBtn) {
      aboutBtn.addEventListener('click', handleMenuToggle(aboutBtn, shopButton, isShopOpen), true);
      shopButton.addEventListener('click', handleMenuToggle(shopButton, aboutBtn, isAboutOpen), true);
    }
  }

  // Mega-menu category selector arrow hover (unchanged)
  document.querySelectorAll('.mega-menu-category-selector').forEach(selector => {
    selector.addEventListener('mouseenter', () => {
      const arrow = selector.querySelector('.navigation-arrow');
      if (arrow) arrow.style.display = 'inline';
    });

    selector.addEventListener('mouseleave', () => {
      const arrow = selector.querySelector('.navigation-arrow');
      if (arrow) arrow.style.display = 'none';
    });
  });

});
</script>
