  <h5 class="variant-selection-heading">Choose Frequency</h5>
</div>
<div class="selling-plan-selector">
  <!-- Subscription Type Radios -->
  <div class="radio-group">
    <label class="radio-label otp-container active-container" checked>
      <input type="radio" name="selling_plan" value="one_time" id="one_time" checked>
      <span class="selector-text">One-Time Purchase</span>
      <div class="plan-selector-price-container">
        {% if product.title == "5PM Happy Hour Kit" %}
          <span id="">{{ all_products['5pm-happy-hour-kit'].price | money }}</span>
        {% else %}
           <span id="ot-original-price" class="original-price"></span>
           <span id="ot-final-price"></span>
           <div id="ot-price-per-drink" class="price-per-drink"></div>
        {% endif %}
       </div>
    </label>
    <label class="radio-label sub-and-save-container">
      <input type="radio" name="selling_plan" value="subscribe" id="subscribe">
      <span class="selector-text">Subscribe & Save</span>
       <div class="plan-selector-price-container">
         {% if product.title == "5PM Happy Hour Kit" %}
            <span id="" class="original-price">{{ all_products['5pm-happy-hour-kit'].price | money }}</span>
            <span id="">$23.99</span>
         {% else %}
           <span id="sub-original-price" class="original-price"></span>
