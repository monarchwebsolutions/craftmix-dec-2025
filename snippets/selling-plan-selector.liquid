           <div id="sub-price-per-drink" class="price-per-drink"></div>
         {% endif %}
       </div>
      <div id="subscription-option-content">
        <div class="subscription-interval-header">Deliver Every</div>
        <!-- Subscription Intervals (Visible only for Subscribe & Save) -->
        <div class="subscription-options" id="subscriptionOptions">
          <button class="sub-option" data-value="4_weeks">4 Weeks</button>
          <button class="sub-option" data-value="6_weeks">6 Weeks</button>
