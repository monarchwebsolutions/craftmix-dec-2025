{{- 'flickity.css' | asset_url | stylesheet_tag -}}
{{- 'flickity.pkgd.min.js' | asset_url | script_tag -}}
<script src="{{ 'custom-carousel.js' | asset_url }}" defer='defer'></script>

{% assign variety_pack = all_products['variety-pack'] %}
{% assign blood_orange = all_products['blood-orange-mai-tai'] %}
{% assign mango_margarita = all_products['mango-margarita'] %}
{% assign mint_mojito = all_products['mint-mojito'] %}
{% assign margarita_variety = all_products['margarita-variety'] %}
{% assign espresso_martini = all_products['espresso-martini'] %}
{% assign classic_margarita = all_products['classic-margarita'] %}
{% assign strawberry_mule = all_products['strawberry-mule'] %}


{% style %}
 *,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

ul {
  list-style: none;
}

a {
  text-decoration: none;
}

img {
  max-width: 100%;
}


.custom-review-header {
  background-color: #bfefff;
  padding: 76px 0px;
}

.custom-review-header-wrapper {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 16px;
}

.review-header-title {
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 64px;
  font-weight: 700;
  letter-spacing: -1.68px;
  text-align: center;
  line-height: 54px;
  margin-bottom: 42px;
}

.review-header-text {
  opacity: 0.9;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 500;
  letter-spacing: -0.11px;
  text-align: center;
  line-height: 24px;
  max-width: 534px;
  margin: 0 auto;
  margin-bottom: 55px;
}


.review-header-logo-carousel {
  background-color: #ddf7f7;
  overflow: hidden;
  width: 100%;
  height: 89px; 
  overflow: hidden;
  background: #ddf7f7;
  display: flex;
  align-items: center;
  justify-content: center; /* Center logos vertically */
  padding: 0;
  margin-bottom: 80px;
}

.review-header-logo-carousel-track {
    display: flex;
    gap: 70px; 
    animation: scrollLogos 20s linear infinite;
    align-items: center; 
}

.review-header-logo-carousel-track img {
  max-height: 39px; /* Restrict logo height */
  width: auto; /* Maintain aspect ratio */
  object-fit: contain; /* Ensure logos scale properly */
}

@keyframes scrollLogos {
    from {
        transform: translateX(0);
    }
    to {
        transform: translateX(-50%);
    }
}

.review-header-stories-subheader {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.43px;
  text-align: center;
  line-height: 17px;
  text-transform: uppercase;
}

.review-header-stories-heading {
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 40px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: -1.05px;
  text-align: center;
  line-height: 46px;
  margin-bottom: 40px;
}

.review-header-stories-cards {
  position: relative;
  display: flex;
  flex-direction: row;
  justify-content: center;
  gap: 40px;
  z-index: 2;
}

.review-header-stories-card {
  max-width: 388px;
  width: 100%;
  min-height: 348px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.review-header-stories-card-title {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -0.1px;
  text-align: left;
  line-height: 33px;
  text-transform: uppercase;
}
.review-header-stories-card-body {
  display: flex;
  flex-direction: row;
  max-width: 388px;
  width: 100%;
  height: 227px;
  border-radius: 30px;
  border: 1.5px solid rgba(0, 38, 87, 1);
  /* background-color: rgba(223, 239, 219, 1); */
  overflow: hidden;
}

.review-header-stories-card-body-image {
  flex: 0 0 41%; 
  height: 100%;
  border-right: 1.5px solid rgba(0, 38, 87, 1);
  overflow: hidden; /* Prevent overflow when image is scaled */
  display: flex;
}

.review-header-stories-card-body-image img {
  width: 100%;
  height: 100%;
  object-fit: cover; 
  display: block; 
}
  
.review-header-stories-card-body-text {
  flex-grow: 1;
  padding: 22px 28px 22px 28px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.review-header-stories-card-body-text-stars {
  width: 80px;
}
  
.review-header-stories-card-body-text-review {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 15px;
  font-weight: 500;
  letter-spacing: -0.09px;
  text-align: left;
  line-height: 19px;
}
.review-header-stories-card-body-text-reviewer {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 12px;
  font-weight: 700;
  letter-spacing: -0.08px;
  text-align: left;
  line-height: 12px;
  text-transform: uppercase;
}

.review-header-stories-card-product {
  max-width: 388px;
  width: 100%;
  height: 72px;
  background-color: #fff;
  box-shadow: 10px 10px 20px rgba(0, 0, 0, 0.13);
  border-radius: 30px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: start;
  padding: 5px 16px;
}

.review-header-stories-card-product-product-cta {
  margin-left: auto;
}
.review-header-stories-card-product-img {
  width: 50px;
  margin-right: 8px;
}
  
.review-header-stories-card-product-product-info-title {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -0.11px;
  text-align: left;
  line-height: 22px;
}

.review-header-stories-card-product-product-info-price {
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 15px;
  font-weight: 500;
  letter-spacing: -0.09px;
  text-align: left;
  line-height: 19px;
}

.review-header-stories-card-product-product-cta button {
  display: inline-block;
  /* color: rgba(0, 38, 87, 1); */
  font-family: 'Goldplay';
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -0.11px;
  text-align: center;
  /* background-color: #60D3F8; */
  padding: 5px 22px;
  border: 1px solid rgba(0, 38, 87, 1);
  border-radius: 30px;
  cursor: pointer;
}
 
.custom-sub-carousel-section {
  padding-top: 110px;
  padding-bottom: 50px;
}
.custom-sub-carousel-header{
  padding-top:1rem;
}

.custom-sub-carousel-subheader {
  color: rgba(0, 38, 87, 1);
  font-family: "Goldplay";
  font-size: 18px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: 0.43px;
  text-align: center;
  line-height: 17px;
  text-transform: uppercase;
  margin-bottom: 8px;
}


.custom-sub-carousel-heading {
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 64px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: -1.68px;
  text-align: center;
  line-height: 54px;
  margin-bottom: 100px;
}

.flickity-slider {
  z-index: 4;
} 

.custom-sub-carousel-container {
  margin-bottom: 60px;
  position: relative;
  padding-top: 86px; /* Add padding to make room for the buttons */
}

.carousel-cell {
  margin-right: 25px;
}

.custom-sub-review-carousel-card {
   height: 558px;
   width: 332px;
   border-radius: 30px;
   border: 1.5px solid rgba(0, 38, 87, 1);
   overflow: hidden;
   position: relative;
   background-color: #f0f0f0;
   box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}
/* first-card class added to first card in carousel for margin */
.custom-video-review-carousel-card {
  margin-left: 25px;
}

.custom-sub-review-carousel-card.first-card {
  margin-left: 25px;
}

.custom-video-review-carousel-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 68px;
  height: 68px;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.play-btn img {
  width: 68px;
  height: 68px;
}

.volume-btn {
  position: absolute;
  top: 10px;
  right: 10px;
  background-color: #fff;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  transition: background-color 0.3s ease;
  border: 2px solid rgba(0, 38, 87, 1);
}

.volume-btn:hover {
  background-color: rgba(255, 255, 255, 0.9);
}

.volume-btn img {
  width: 20px;
  height: 20px;
}

.product-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 12px 15px 10px 15px ;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
  margin-left: 10px;
  margin-right: 10px;
  border-radius: 20px;
}

.product-info-text {
  flex-grow: 1;
}

.stars img {
  width: 55px;
  height: auto;
}

.product-title {
  margin: 5px 0 0 0;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 15px;
  font-weight: 600;
  letter-spacing: -0.09px;
  text-align: left;
  line-height: 16px;
}

.product-variant {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: "Goldplay";
  font-size: 15px;
  font-weight: 500;
  font-style: Medium;
  letter-spacing: -0.09px;
  text-align: left;
  line-height: 19px;
}

.product-info-cta-btn {
  font-family: "Goldplay";
  background-color: rgba(96, 211, 248, 1);
  color: rgba(0, 38, 87, 1);
  padding: 10px 28px;
  border-radius: 20px;
  text-decoration: none;
  font-weight: 600;
  font-size: 18px;
  line-height: 22px;
  border-radius: 23px;
  border: 1.5px solid rgba(0, 38, 87, 1);

}

.custom-video-review-carousel-cta {
  text-align: center;
}

.custom-video-review-carousel-cta-btn {
  display: inline-block;
  border: 1.5px solid rgba(0, 38, 87, 1);
  box-shadow: 2px 2px 0px rgba(0, 38, 87, 1);
  border-radius: 30px;
  opacity: 1;
  background-color: rgba(96, 211, 248, 1);
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 20px;
  font-weight: 600;
  font-style: SemiBold;
  letter-spacing: -0.13px;
  text-align: center;
  line-height: 20px;
  padding: 20px;
}


  
/* Media Queries */
@media (max-width: 1300px) {
  .review-header-stories-cards {
    display: flex;
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
  }
  .review-header-stories-cards .item:last-child {
    width: 100%;
    text-align: center;
  }
}



@media (max-width: 876px) {
  .review-header-stories-cards {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
}

@media (max-width: 768px) {
  .review-header-logo-carousel {
    height: 60px; 
    margin-bottom: 80px;
  }
  
  .review-header-logo-carousel-track {
      display: flex;
      gap: 70px; 
      animation: scrollLogos 20s linear infinite;
      align-items: center; 
  }
  
  .review-header-logo-carousel-track img {
    max-height: 26px; 
    width: auto; 
    object-fit: contain; 
  }

  .custom-sub-carousel-heading {
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -1.05px;
    text-align: center;
    line-height: 40px;
  }  
}
  
@media (max-width: 528px) {
  .review-header-title {
    font-size: 40px;
    letter-spacing: -1.05px;
    line-height: 40px;
    margin-bottom: 20px;
  }
  .review-header-text {
    margin-bottom: 21px;
  }
  .review-header-carousel {
    width: 100%;
    height: 60px;
    margin-bottom: 68px;
    background-color: #ddf7f7;
  }
  .review-header-stories-heading {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.79px;
    line-height: 35px;
    margin-bottom: 37px;
  }
  .custom-sub-review-carousel-card.first-card {
  margin-left: 0px;
}
}
@media (max-width: 400px) {
  .review-header-stories-card-body-text {
    flex-grow: 1;
    padding: 15px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
}

@media (max-width: 360px) {
  .review-header-stories-card-body-text-review {
    font-size: 12px;
    font-weight: 500;
    line-height: 15px;
  }
}





