{% javascript %}

  document.addEventListener("DOMContentLoaded", function () {
    const cards = document.querySelectorAll(".custom-sub-review-carousel-card");
    const videos = document.querySelectorAll(".custom-video-review-carousel-video");

    function pauseAllOtherVideos(currentVideo) {
      videos.forEach((video) => {
        if (video !== currentVideo) {
          video.pause();
          const parentCard = video.closest(".custom-sub-review-carousel-card");
          const playBtn = parentCard?.querySelector(".play-btn");
          if (playBtn) playBtn.style.display = "block";
        }
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target;
          if (!entry.isIntersecting) {
            video.pause();
            const parentCard = video.closest(".custom-sub-review-carousel-card");
            const playBtn = parentCard?.querySelector(".play-btn");
            if (playBtn) playBtn.style.display = "block";
          }
        });
      },
      { threshold: 0.1 }
    );

    cards.forEach((card) => {
      const video = card.querySelector(".custom-video-review-carousel-video");
      const playBtn = card.querySelector(".play-btn");
      const volumeBtn = card.querySelector(".volume-btn");
      const volumeIcon = volumeBtn?.querySelector(".volume-icon");
      const muteIcon = volumeBtn?.querySelector(".mute-icon");

      if (!video) return;

      function toggleVideoPlay() {
        if (video.paused) {
          pauseAllOtherVideos(video);
          video.muted = false;
          video.play().then(() => {
            if (playBtn) playBtn.style.display = "none";
          }).catch((err) => {
            console.error("Video play failed:", err);
          });
        } else {
          video.pause();
          if (playBtn) playBtn.style.display = "block";
        }
      }

      video.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleVideoPlay();
      });

      if (playBtn) {
        playBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          toggleVideoPlay();
        });
      }

      video.addEventListener("ended", () => {
        if (playBtn) playBtn.style.display = "block";
      });

      if (volumeBtn) {
        volumeBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          video.muted = !video.muted;
          if (volumeIcon && muteIcon) {
            volumeIcon.style.display = video.muted ? "none" : "block";
            muteIcon.style.display = video.muted ? "block" : "none";
          }
        });
      }

      observer.observe(video);
    });
  });



document.addEventListener("DOMContentLoaded", function () {
    const track = document.querySelector(".review-header-logo-carousel-track");
    const logos = track.innerHTML; 
    track.innerHTML += logos;
});

{% endjavascript %}
