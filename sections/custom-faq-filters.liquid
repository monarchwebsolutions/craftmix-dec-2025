<section class="custom-faq-filters">
  <div class="custom-faq-filter-container">
      <div class="faq-filters">
          <button class="custom-faq-filter active" data-category="product">Product</button>
          <button class="custom-faq-filter" data-category="ingredient">Ingredients</button>
          <button class="custom-faq-filter" data-category="shipping">Shipping</button>
          <button class="custom-faq-filter" data-category="account">Account & Subscription</button>
      </div>
  </div>
</section>


{% style %}
*,
*::after,
*::before {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.custom-faq-filters {
  width: 100%;
  height: 100px;
  background-color: #ddf7f7;
}

.custom-faq-filter-container {
  margin: 0 auto;
  min-height: 42px;
}

.faq-filters {
  width: 100%;
  min-height: 42px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 10px;
  gap: 5px;
}

button.custom-faq-filter {
  border-radius: 23px;
  border: 1.5px solid rgba(0, 38, 87, 0);
  background-color: rgba(96, 211, 248, 0);
  color: rgba(0, 38, 87, 1);
  font-family: "Goldplay";
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -0.11px;
  text-align: left;
  line-height: 22px;
  padding: 10px 46px;
  transition: all 0.3s ease-in-out; 
}

button.custom-faq-filter:hover,
button.custom-faq-filter.active {
  border: 1.5px solid rgba(0, 38, 87, 1);
  background-color: rgba(96, 211, 248, 1);
}

@media (max-width: 835px) {
  button.custom-faq-filter {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.1px;
    line-height: 20px;
    padding: 8px 27px;
    transition: all 0.3s ease-in-out; 
  }
}

@media (max-width: 630px) {
  .custom-faq-filter-container {
    width: 100%;
    overflow-x: auto; /* Enables horizontal scrolling */
    -webkit-overflow-scrolling: touch; /* Smooth scrolling on mobile */
    padding: 0 20px 17px; /* Adds left/right padding and space below */
    position: relative;
  }

  .faq-filters {
    display: flex;
    flex-wrap: nowrap;
    width: max-content;
    gap: 10px;
    padding-bottom: 10px;
    padding-left: 0px;
  }

  button.custom-faq-filter {
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* Custom scrollbar styling */
  .custom-faq-filter-container::-webkit-scrollbar {
    height: 4px; /* Thin scrollbar */
  }

  .custom-faq-filter-container::-webkit-scrollbar-thumb {
    background: rgba(0, 38, 87, 1); /* Scrollbar color */
    border-radius: 10px;
  }

  .custom-faq-filter-container::-webkit-scrollbar-track {
    background: rgba(0, 38, 87, 0.16);
    margin: 0 20px; /* Left & right padding */
  }
}




{% endstyle %}
{% comment %}
  

{% javascript %}
document.addEventListener("DOMContentLoaded", function () {
    const buttons = document.querySelectorAll(".custom-faq-filter");
    const sections = document.querySelectorAll(".faq-section");

    buttons.forEach((button) => {
        button.addEventListener("click", function () {
            let category = this.getAttribute("data-category");

            // If the button is already active, reset (show all sections)
            if (this.classList.contains("active")) {
                buttons.forEach(btn => btn.classList.remove("active"));
                sections.forEach(section => section.style.display = "block");
            } else {
                // Remove active class from all buttons
                buttons.forEach(btn => btn.classList.remove("active"));
                this.classList.add("active");

                // Show only the selected category
                sections.forEach((section) => {
                    if (section.getAttribute("data-category") === category) {
                        section.style.display = "block";
                    } else {
                        section.style.display = "none";
                    }
                });
            }
        });
    });
});
{% endjavascript %}
{% endcomment %}
{% javascript %}
document.addEventListener("DOMContentLoaded", function () {
  const buttons = document.querySelectorAll(".custom-faq-filter");

  buttons.forEach((button) => {
    button.addEventListener("click", function () {
      const category = this.getAttribute("data-category");
      const targetSection = document.getElementById(category);

      // Set active button state
      buttons.forEach(btn => btn.classList.remove("active"));
      this.classList.add("active");

      // Scroll smoothly to the section
      if (targetSection) {
        targetSection.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
});
{% endjavascript %}



