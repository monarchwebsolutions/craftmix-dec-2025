/* Add these styles to hide the radio buttons visually while keeping them accessible */
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}

/* Update these selectors to target the label instead of the div */
.flavor-card,
.select-quantity-btn,
.select-delivery-btn {
  cursor: pointer;
}

/* Add styles for the checked state */
input:checked + .flavor-card-content,
input:checked + span {
  /* Add your active styles here */
  /* For example: */
  background-color: #f0f0f0;
  border-color: #333;
}

document.addEventListener('DOMContentLoaded', function () {
  const form = document.getElementById('product-selection-form');
  const flavorCards = form.querySelectorAll('.flavor-card input');
  const quantityBtns = form.querySelectorAll('.select-quantity-btn input');
  const deliveryBtns = form.querySelectorAll('.select-delivery-btn input');

  function updateActiveClass(elements) {
    elements.forEach(el => {
      const label = el.closest('label');
      if (el.checked) {
        label.classList.add('active');
      } else {
        label.classList.remove('active');
      }
    });
  }

  flavorCards.forEach(card => {
    card.addEventListener('change', function() {
      updateActiveClass(flavorCards);
      // Update product image and other details here
    });
  });

  quantityBtns.forEach(btn => {
    btn.addEventListener('change', function() {
      updateActiveClass(quantityBtns);
    });
  });

  deliveryBtns.forEach(btn => {
    btn.addEventListener('change', function() {
      updateActiveClass(deliveryBtns);
    });
  });

  // Initialize active classes
  updateActiveClass(flavorCards);
  updateActiveClass(quantityBtns);
  updateActiveClass(deliveryBtns);

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    // Handle form submission here (e.g., add to cart via AJAX)
    console.log('Form submitted');
  });
});
