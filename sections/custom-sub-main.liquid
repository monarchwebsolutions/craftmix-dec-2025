<script>
  document.addEventListener("DOMContentLoaded", function () {
    function handleActiveClass(containerSelector, buttonSelector) {
        const container = document.querySelector(containerSelector);
        if (!container) return;

        const buttons = container.querySelectorAll(buttonSelector);

        buttons.forEach(btn => {
            btn.addEventListener("click", function () {
                // Remove active class from all buttons in this group
                buttons.forEach(b => b.classList.remove("active"));

                // Add active class to the clicked button
                this.classList.add("active");
            });
        });
    }

    // Apply function to both groups
    handleActiveClass(".select-quantity-btns", ".select-quantity-btn");
    handleActiveClass(".select-delivery-btns", ".select-delivery-btn");
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const slider = document.querySelector('.change-flavor-body');
  const flavorCards = document.querySelectorAll('.flavor-card');
  let isDown = false;
  let startX;
  let scrollLeft;
  let isDragging = false;

  // Store the first product title
  let firstProductTitle = '';
  if (flavorCards.length > 0) {
    firstProductTitle = flavorCards[0].querySelector('.flavor-card-heading').textContent.replace(/^2025 - /, '');
  }

  // Display the first product title
  const productTitleElement = document.querySelector('.subscription-product-title');
  if (productTitleElement && firstProductTitle) {
    productTitleElement.textContent = firstProductTitle;
  }

  // Slider functionality
  if (slider) {
    slider.addEventListener('mousedown', (e) => {
      isDown = true;
      slider.style.cursor = 'grabbing';
      startX = e.pageX - slider.offsetLeft;
      scrollLeft = slider.scrollLeft;
    });

    slider.addEventListener('mouseleave', () => {
      isDown = false;
      slider.style.cursor = 'grab';
    });

    slider.addEventListener('mouseup', () => {
      isDown = false;
      slider.style.cursor = 'grab';
    });

    slider.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - slider.offsetLeft;
      const walk = (x - startX) * 2; // Scroll speed
      slider.scrollLeft = scrollLeft - walk;
      isDragging = true;
    });
  }

  // Flavor selection functionality
  flavorCards.forEach(card => {
    card.addEventListener('click', function(e) {
      if (!isDragging) {
        // Remove active class from all li elements
        document.querySelectorAll('.change-flavor-list li').forEach(li => li.classList.remove('active'));
        // Add active class to the parent li of the clicked card
        this.closest('li').classList.add('active');
        
        // Update product title
        const newTitle = this.querySelector('.flavor-card-heading').textContent.replace(/^2025 - /, '');
        if (productTitleElement) {
          productTitleElement.textContent = newTitle;
        }
        
        // Update product image
        const newImageSrc = this.dataset.productImage;
        const productImage = document.querySelector('.product-image img') || document.querySelector('.pdp-main-img-container img');
        if (productImage && newImageSrc) {
          productImage.src = newImageSrc;
          productImage.alt = this.querySelector('img')?.alt || newTitle; // Update alt text for accessibility
          productImage.removeAttribute('style');
        }

        // Update main image bg color
        const imageContainer = document.querySelector(".product-image-container");
        const newBgColor = this.dataset.productBg;
        imageContainer.style.backgroundColor = newBgColor;

        // Update card bg color
        const allCards = document.querySelectorAll(".flavor-card-container .flavor-card");

        // Update Flavor Range Percentage
        const flavorPercentRaw = card.querySelector(".flavor-range-percent")?.innerHTML.trim();
        const flavorPercent = flavorPercentRaw === "" ? 50 : parseInt(flavorPercentRaw, 10) || 50;
        console.log('Flavor %:', flavorPercent);

        // Add What's Included for Variety Packs
        const whatsIncluded = document.getElementById("whats-included-container");
        
        if (newTitle.trim() == "Variety Pack") {
          whatsIncluded.innerHTML = "<strong>Included:</strong><br>Strawberry Mule, Passionfruit Paloma, Blood Orange Mai Tai & Mango Margarita";
        } else if (newTitle.trim() == "Lemonade Variety") {
          whatsIncluded.innerHTML = "<strong>Included:</strong><br>Classic Lemonade, Blueberry Lemonade & Pink Lemonade";
        } else if (newTitle.trim() == "Holiday Variety") {
          whatsIncluded.innerHTML = "<strong>Included:</strong><br>Spiked Apple Cider, Cranberry Vanilla & Espresso Martini";
        } else if (newTitle.trim() == "5PM Happy Hour Kit") {
          whatsIncluded.innerHTML = "<strong>Included:</strong><br>Blood Orange Mai Tai, Strawberry Mule, Mango Margarita, Passionfruit Paloma & Mint Mojito";
        } else {
          whatsIncluded.innerText = "";
        }

          
        const flavorRangeBar = document.querySelector(".flavor-range-fill");
        if (flavorRangeBar) {
          flavorRangeBar.style.width = `${flavorPercent}%`;
        }
        
        const flavorIcon = document.querySelector(".flavor-range .flavor-icon");
        if (flavorIcon) {
          flavorIcon.style.left = `calc(${flavorPercent}% - 3rem)`;
        }

        // Update Flavor Type
        const flavorTypeRaw = card.querySelector(".flavor-type")?.innerHTML.trim();
        const flavorType = flavorTypeRaw === "" ? "Sour" : flavorTypeRaw;

        const flavorTypeContainer = document.querySelector(".sour-label");
        if (flavorTypeContainer) {
          flavorTypeContainer.innerText = flavorType
        }

        allCards.forEach(card => {
            card.style.backgroundColor = "white";
        });

        const selectedCard = document.querySelector(".flavor-card-container.active .flavor-card");
        selectedCard.style.backgroundColor = newBgColor;

        console.log('Selected product:', newTitle, 'Product ID:', this.dataset.productId);
      }
      isDragging = false;
    });
  });

  // Reset isDragging on mouse up
  document.addEventListener('mouseup', () => {
    isDragging = false;
  });

  // Set initial active flavor image
  const activeFlavor = document.querySelector('.change-flavor-list li.active .flavor-card');
  if (activeFlavor) {
    const productImage = activeFlavor.dataset.productImage;
    const mainImage = document.querySelector('.pdp-main-img-container img');
    if (mainImage && productImage) {
      mainImage.src = productImage;
    }
  }

  // Log the first product title for verification
  console.log('First Product Title:', firstProductTitle);
});


  // Flavor bar
document.addEventListener('DOMContentLoaded', function () {
  const flavorBars = document.querySelectorAll('.flavor-bar');

  flavorBars.forEach(flavorBar => {
    let sweetnessPercentage = 50; // Default value if no data is found

    // Check if the metafield exists and has a value
    if (typeof meta !== 'undefined' && meta.product && meta.product.sweetness_percentage) {
      sweetnessPercentage = parseInt(meta.product.sweetness_percentage, 10);
    }

    // Ensure the sweetness percentage is within 0-100 range
    sweetnessPercentage = Math.max(0, Math.min(100, sweetnessPercentage));

    setFlavorRange(flavorBar, sweetnessPercentage);
  });
});

function setFlavorRange(flavorBar, percentage) {
  const fillElement = flavorBar.querySelector('.flavor-range-fill');
  const iconElement = flavorBar.querySelector('.flavor-icon');
  
  if (fillElement && iconElement) {
    fillElement.style.width = `${percentage}%`;
    iconElement.style.left = `calc(${percentage}% - 3rem)`;
  }
}  
</script>
