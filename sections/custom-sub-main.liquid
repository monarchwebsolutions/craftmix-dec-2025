.change-flavor-body {
  height: 176px;
  margin-bottom: 23px;
  overflow-x: auto;
  overflow-y: hidden; /* Hide vertical scrollbar */
  cursor: grab;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin; /* Firefox */
  scrollbar-color: rgba(0, 38, 87, 0.16) transparent; /* For Firefox */
  user-select: none;
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  position: relative; /* for blur overlay */
  mask-image: linear-gradient(
    to right,
    black calc(100% - 200px),
    transparent 100%
  );
  -webkit-mask-image: linear-gradient(
    to right,
    black calc(100% - 200px),
    transparent 100%
  );
}

change-flavor-body:active {
  cursor: grabbing;
}

/* Styling for WebKit browsers (Chrome, Safari, etc.) */
.change-flavor-body::-webkit-scrollbar {
  height: 4px; /* Slightly increased height for better visibility */
}

.change-flavor-body::-webkit-scrollbar-track {
  background: rgba(0, 38, 87, 0.05); /* Light background for the track */
  border-radius: 2px;
}

.change-flavor-body::-webkit-scrollbar-thumb {
  background-color: rgba(
    0,
    38,
    87,
    0.2
  ); /* Slightly darker for better contrast */
  border-radius: 3px;
}
.change-flavor-body::-webkit-scrollbar-thumb:hover {
  background-color: rgba(0, 38, 87, 0.3); /* Darker on hover */
}

/* Hide scrollbar for IE, Edge and Firefox */
.change-flavor-body {
  -ms-overflow-style: none; /* IE and Edge */
  scrollbar-width: thin; /* Firefox */
}

