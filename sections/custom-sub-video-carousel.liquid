{{- 'flickity.css' | asset_url | stylesheet_tag -}}
{{- 'flickity.pkgd.min.js' | asset_url | script_tag -}}
<script src="{{ 'custom-carousel.js' | asset_url }}" defer='defer'></script>

<div >
  <div style="background-color: {{ section.settings.background_color }} !important;"  class="custom-sub-carousel-section">
    <div class="custom-sub-carousel-header">
      <h5 class="custom-sub-carousel-subheader">customer Favorites </h5>
      <h3 class="custom-sub-carousel-heading">What Our Fans Say</h3>
    </div>

    <div class="custom-sub--carousel-container">
      <!-- Name of carousel unique for flickity -->
      <div class="custom-carousel">


       <!-- Carousel Items Start  -->
         {% for block in section.blocks %}
          {% assign video_url = block.settings.video_url %}
          {% assign thumbnail = block.settings.thumbnail %}
          {% assign linked_product = block.settings.linked_product %}
          <!-- class of first-card to first carousel item to provide margin  -->
          <div class="carousel-cell">
            <div class="custom-sub-review-carousel-card {% if forloop.first %}first-card{% endif %}">
               
              <video 
                class="custom-video-review-carousel-video"
                playsinline 
                preload="auto"
                src="{{ block.settings.video_url }}"
                {% if block.settings.thumbnail != blank %} 
                  poster="{{ block.settings.thumbnail | image_url }}" 
                {% endif %}
              >
              </video>
              <div class="play-btn">
                  <img src="https://cdn.shopify.com/s/files/1/2340/1623/files/carousel-card-play-btn.svg?v=1738191527" alt="Play"
                    class="play-icon">
                  <img src="https://cdn.shopify.com/s/files/1/2340/1623/files/icons8-pause-button-30.png?v=1738103868" alt="Pause"
                    class="pause-icon" style="display: none;">
                </div>
      
               <div class="volume-btn">
                  <img
                    src="https://cdn.shopify.com/s/files/1/2340/1623/files/Speaker_Icon_7d83b52f-cbca-4d55-ac43-c5293b0d97a4.png?v=1734273205"
                    alt="Volume" class="volume-icon">
                  <img
                    src="https://cdn.shopify.com/s/files/1/2340/1623/files/Mute_Icon_77a389ee-8a3a-415f-9dd5-741c7c752fcb.png?v=1734273205"
                    alt="Mute" class="mute-icon" style="display: none;">
                </div>
      
                 
                  <div class="carousel-product-info">
                    <div class="carousel-product-info-text">
                      <div class="stars">
                        <img src="{{ 'stars-dark.svg' | asset_url }}" alt="Five dark blue stars">
                      </div>
                      <h5 class="carousel-product-title">{{ linked_product.title | remove_first: '2025 - ' }}</h5>
                      <p class="carousel-product-variant">
                        {{ linked_product.variants.first.title }} - {{ linked_product.price | money }}
                      </p>
                    </div>
                    <div class="carousel-product-info-cta">
                      <form method="post" action="/cart/add">
                        <input type="hidden" name="id" value="{{ linked_product.variants.first.id }}">
                        <button type="submit" class="carousel-product-info-cta-btn">Add</button>
                      </form>
                    </div>
                  </div>
               

    
            </div>
          </div>
        {% endfor %} 
        <!-- Carousel Items End  -->

      </div>


    </div>
  </div>
</div>  

{% style %}


 *,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

ul {
  list-style: none;
}

a {
  text-decoration: none;
}

img {
  max-width: 100%;
}
  
.custom-sub-carousel-section {
  padding-top: 50px;
  padding-bottom: 50px;
  /* background-color: #bfefff ; */
}
.custom-sub-carousel-header{
  padding-top:1rem;
}

.custom-sub-carousel-subheader {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: "Goldplay";
  font-size: 18px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: 0.43px;
  text-align: center;
  line-height: 17px;
  text-transform: uppercase;
  margin-bottom: 8px;
}


.custom-sub-carousel-heading {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Hornbill';
  font-size: 64px;
  font-weight: 700;
  font-style: Bold;
  letter-spacing: -1.68px;
  text-align: center;
  line-height: 54px;
  margin-bottom: 100px;
}


.custom-sub-carousel-container {
  margin-bottom: 60px;
  position: relative;
  padding-top: 86px; /* Add padding to make room for the buttons */
}

.carousel-cell {
  margin-right: 25px;
}

.custom-sub-review-carousel-card {
   height: 558px;
   width: 332px;
   border-radius: 30px;
   border: 1.5px solid rgba(0, 38, 87, 1);
   overflow: hidden;
   position: relative;
   background-color: #f0f0f0;
   box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}
/* first-card class added to first card in carousel for margin */
.custom-video-review-carousel-card {
  margin-left: 25px;
}

.custom-sub-review-carousel-card.first-card {
  margin-left: 25px;
}

.custom-video-review-carousel-video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 68px;
  height: 68px;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  transition: background-color 0.3s ease;
}

.play-btn img {
  width: 68px;
  height: 68px;
}

.volume-btn {
  position: absolute;
  top: 10px;
  right: 10px;
  background-color: #fff;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  transition: background-color 0.3s ease;
  border: 2px solid rgba(0, 38, 87, 1);
}

.volume-btn:hover {
  background-color: rgba(255, 255, 255, 0.9);
}

.volume-btn img {
  width: 20px;
  height: 20px;
}

.carousel-product-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 12px 15px 10px 15px ;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
  margin-left: 10px;
  margin-right: 10px;
  border-radius: 20px;
}

.carousel-product-info-text {
  flex-grow: 1;
}

.stars img {
  width: 55px;
  height: auto;
}

.carousel-product-title {
  margin: 5px 0;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 15px;
  font-weight: 600;
  letter-spacing: -0.09px;
  text-align: left;
  line-height: 16px;
}

.carousel-product-variant {
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: "Goldplay";
  font-size: 15px;
  font-weight: 500;
  letter-spacing: -0.09px;
  text-align: left;
  line-height: 19px;
}

.carousel-product-info-cta {
  background-color: rgba(96, 211, 248, 1);
  color: rgba(0, 38, 87, 1);
  padding: 10px 28px;
  border-radius: 20px;
  text-decoration: none;
  font-weight: bold;
  font-size: 14px;
  transition: background-color 0.3s ease;
  border-radius: 23px;
  border: 1.5px solid rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 20px;
  font-weight: 600;

}

.custom-video-review-carousel-cta {
  text-align: center;
}

.custom-video-review-carousel-cta-btn {
  display: inline-block;
  border: 1.5px solid rgba(0, 38, 87, 1);
  box-shadow: 2px 2px 0px rgba(0, 38, 87, 1);
  border-radius: 30px;
  opacity: 1;
  background-color: rgba(96, 211, 248, 1);
  opacity: 1;
  color: rgba(0, 38, 87, 1);
  font-family: 'Goldplay';
  font-size: 20px;
  font-weight: 600;
  font-style: SemiBold;
  letter-spacing: -0.13px;
  text-align: center;
  line-height: 20px;
  padding: 20px;
}
.faq-cta{
  padding: 1.25rem 0.5rem !important;
  width:100%;
}
.custom-subscription-faq-section{
  padding-bottom:0 !important;
}
  
/* Media Queries */
@media screen and (max-width: 1050px) {
  
}
@media (max-width: 768px) {
  .custom-sub-carousel-heading {
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -1.05px;
    text-align: center;
    line-height: 40px;
    margin-bottom: 3.5rem;
  }  
  .subscription-management-card .text-box h2{
    font-size:2rem;
  }
  .faq-cta{
    max-width: 500px;
    width: 100%;
  }
}

@media (max-width: 529px) {
  .custom-sub-review-carousel-card.first-card {
    margin-left: 0px;
  }
}
@media (max-width: 429px) {
  .faq-cta{
    font-size: 1.125rem !important;
  }
}

  

{% endstyle %}


{% javascript %}
document.addEventListener('DOMContentLoaded', () => {
  const cards = document.querySelectorAll('.custom-sub-review-carousel-card');
  const videos = document.querySelectorAll('.custom-video-review-carousel-video');

  cards.forEach(card => {
    const video = card.querySelector('.custom-video-review-carousel-video');
    const playBtn = card.querySelector('.play-btn');
    const volumeBtn = card.querySelector('.volume-btn');
    const volumeIcon = volumeBtn.querySelector('.volume-icon');
    const muteIcon = volumeBtn.querySelector('.mute-icon');

    // Fade-in fix: Add 'ready' class once video is actually rendering a frame
    video.addEventListener('playing', () => {
      video.classList.add('ready');
    });

    // Play/Pause Button Click
    playBtn.addEventListener('click', () => {
      if (video.paused) {
        pauseAllVideos(video); // Ensure only one video plays
        video.play();
        playBtn.style.display = 'none';
      } else {
        video.pause();
        playBtn.style.display = 'block';
      }
    });

    // Video Click to Play/Pause
    video.addEventListener('click', () => {
      if (video.paused) {
        pauseAllVideos(video);
        video.play();
        playBtn.style.display = 'none';
      } else {
        video.pause();
        playBtn.style.display = 'block';
      }
    });

    // Reset Play Button when Video Ends
    video.addEventListener('ended', () => {
      playBtn.style.display = 'block';
    });

    // Volume Control Button
    volumeBtn.addEventListener('click', () => {
      if (video.muted) {
        video.muted = false;
        volumeIcon.style.display = 'block';
        muteIcon.style.display = 'none';
      } else {
        video.muted = true;
        volumeIcon.style.display = 'none';
        muteIcon.style.display = 'block';
      }
    });
  });

  // Function to Pause All Other Videos
  function pauseAllVideos(currentVideo) {
    videos.forEach(video => {
      if (video !== currentVideo) {
        video.pause();
      }
    });
  }

  // Pause Videos When They Go Out of View
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) {
        entry.target.pause();
      }
    });
  }, { threshold: 0.1 });

  videos.forEach(video => observer.observe(video));
});
{% endjavascript %}

{% schema %}
  {
    "name": "Custom sub video carousel",
    "settings": [
       {
        "type": "color",
        "id": "background_color",
        "label": "Background color",
        "default": "#ffffff"
      }
    ],
     "blocks": [
   {
  "type": "carousel_card",
  "name": "Carousel Card",
  "settings": [
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL",
      "info": "Upload video to Content > Files, then paste the link here (e.g., .mp4, .mov)"
    },
    {
      "type": "image_picker",
      "id": "thumbnail",
      "label": "Thumbnail Image"
    },
    {
      "type": "product",
      "id": "linked_product",
      "label": "Linked Product"
    }
  ]
}
  ],
  "max_blocks": 8,
   "presets": [{"name": "Custom sub video Carousel"}]
  }
{% endschema %}